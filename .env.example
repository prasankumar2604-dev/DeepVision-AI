# ==========================================================
# DeepVision AI — Environment Configuration Template
# Duplicate this file as '.env' and populate with your credentials.
# NEVER commit your real '.env' file containing secrets to version control.
# ==========================================================

# ----------------------------------------------------------
# 1. Flask & Session Security
# ----------------------------------------------------------
# Secret key used to sign session cookies and cryptographic tokens.
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_64_chars

# Application environment ('production' or 'development')
FLASK_ENV=development

# Enforce HTTPS-only cookies (Set to 'true' in production with SSL/HTTPS)
SESSION_COOKIE_SECURE=false

# Port on which the application listens (default: 5000)
PORT=5000

# Base URL used for email reset links (e.g. http://localhost:5000 or https://yourdomain.com)
APP_BASE_URL=http://localhost:5000

# ----------------------------------------------------------
# 2. SQLite Database Path
# ----------------------------------------------------------
DATABASE_PATH=database/deepvision.db
UPLOAD_FOLDER=static/uploads

# ----------------------------------------------------------
# 3. SMTP Email Configuration (Required for Live 2FA & Password Resets)
# ----------------------------------------------------------
# Hostname of your SMTP server:
# - Gmail: smtp.gmail.com
# - Outlook: smtp-mail.outlook.com
# - SendGrid: smtp.sendgrid.net
# - Mailgun: smtp.mailgun.org
SMTP_HOST=smtp.gmail.com

# SMTP Port: 587 (for STARTTLS) or 465 (for SSL)
SMTP_PORT=587

# SMTP Account / Username (e.g. your email address)
SMTP_USERNAME=your_email@gmail.com

# SMTP Password / Application Password:
# For Gmail, enable 2FA on Google Account and generate a dedicated 16-character 'App Password'
# at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_char_google_app_password

# Enable STARTTLS (recommended for port 587)
SMTP_USE_TLS=true

# Enable SSL (recommended for port 465)
SMTP_USE_SSL=false

# Sender address shown in the "From" header of emails
MAIL_FROM="DeepVision AI Security" <your_email@gmail.com>

# ----------------------------------------------------------
# Note on Local Development without SMTP:
# If SMTP variables are left blank, DeepVision AI will output
# the 6-digit OTP codes and password reset links directly to
# your server console terminal, allowing local testing without
# sending real emails. Accounts are never marked verified without
# manually submitting the correct code.
# ----------------------------------------------------------
