# ==========================================================
# DeepVision AI — Docker Ignore Configuration
# Prevents large datasets, cache, and local secrets from entering image
# ==========================================================

# Git metadata
.git/
.gitignore
.github/

# Virtual Environment
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Large Datasets & Archives (Crucial: train_100k.zip is ~2.8GB!)
dataset/
dataset_small/
*.zip
*.tar
*.tar.gz
*.rar

# Training scripts, tests & evaluation plots
train.py
check_model.py
test_*.py
model/plots/

# Local Database Files (Database data is managed via persistent volume mount)
database/*.db
database/.flask_secret

# Local Uploads (Persisted via Docker volume)
static/uploads/*
!static/uploads/.gitkeep

# Environment & Local Secrets
.env
.env.*
*.env

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Documentation & Scratch Files
*.md
!README.md
scratch/
